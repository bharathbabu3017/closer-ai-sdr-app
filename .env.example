# ── Core ─────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
# Model used for every agent step
AGENT_MODEL=claude-opus-5
# true = log emails / CRM / Telegram instead of calling the real apps. Set to false once integrations are configured.
DRY_RUN=true

# Public URL of this app (used by scripts and in links)
APP_URL=http://localhost:3000
# Shared secret for the form webhook: send as ?token=... or the x-webhook-token header. Empty = no auth (local dev only).
WEBHOOK_SECRET=

# SQLite file shared by the web app and the worker
DATABASE_PATH=./data/closer.db
# Optional: path to your agent config (defaults to agent.config.yaml, then agent.config.example.yaml)
# AGENT_CONFIG_PATH=
