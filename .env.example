# ── Core ─────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
AGENT_MODEL=claude-opus-5
# true = log every external action instead of calling the apps. Otherwise each app goes live once its keys are set.
DRY_RUN=false

APP_URL=http://localhost:3000
# Shared secret for the form webhook (?token=... or x-webhook-token header). Empty = no auth (local dev only).
WEBHOOK_SECRET=
DATABASE_PATH=./data/closer.db

# ── Gmail (send outreach) ────────────────────────────────────────────
# App password: myaccount.google.com/apppasswords (requires 2-step verification)
GMAIL_USER=
GMAIL_APP_PASSWORD=

# ── Notion (CRM + pre-call briefs) ───────────────────────────────────
# Create an internal integration at notion.so/profile/integrations, share a page with it,
# then run `npm run setup notion` to create the database and print NOTION_DATABASE_ID.
NOTION_TOKEN=
NOTION_PARENT_PAGE_ID=
NOTION_DATABASE_ID=

# ── Telegram (team alerts) ───────────────────────────────────────────
# Create a bot with @BotFather, message it (or add it to your sales group), then `npm run setup telegram`.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
